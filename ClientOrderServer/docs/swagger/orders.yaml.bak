openapi: 3.0.0
paths:
  /api/orders/numbers:
    get:
      tags:
        - Orders
      summary: Lấy danh sách số thứ tự đơn hàng hôm nay
      description: |
        Lấy danh sách tất cả đơn hàng trong ngày hiện tại để hiển thị trên dashboard hoặc caller screen.
        
        **Quy trình:**
        - Lọc đơn hàng theo shopCode của user đăng nhập
        - Lọc theo ngày hiện tại (created_at từ 00:00:00 đến 23:59:59)
        - Trả về danh sách đơn hàng kèm thông tin món ăn
        
        **Sử dụng:** Dashboard view, Order caller view
      security:
        - bearerAuth: []
      responses:
        '200':
          description: Lấy danh sách thành công
          content:
            application/json:
              schema:
                type: object
                properties:
                  success:
                    type: boolean
                    example: true
                  data:
                    type: array
                    items:
                      type: object
                      properties:
                        id:
                          type: integer
                          description: ID của đơn hàng
                          example: 123
                        orderNumber:
                          type: string
                          description: Số đơn hàng (format: [shopCode][deviceCode][seq])
                          example: "HBC001KSK0012510230001"
                        status:
                          type: integer
                          description: |
                            Trạng thái đơn hàng
                            - 0: Cancelled (Đã hủy)
                            - 1: Received (Đã nhận)
                            - 2: Processing (Đang thực hiện)
                            - 3: Completed (Đã hoàn thành)
                            - 4: Delivered (Đã giao)
                          enum: [0, 1, 2, 3, 4]
                          example: 2
                        paymentStatus:
                          type: integer
                          description: |
                            Trạng thái thanh toán
                            - 0: Unpaid (Chưa thanh toán)
                            - 1: Paid (Đã thanh toán)
                          enum: [0, 1]
                          example: 0
                        totalPrice:
                          type: number
                          description: Tổng tiền đơn hàng
                          example: 95000
                        note:
                          type: string
                          nullable: true
                          description: Ghi chú của khách hàng
                          example: "Không hành"
                        foods:
                          type: array
                          description: Danh sách món ăn trong đơn
                          items:
                            type: object
                            properties:
                              id:
                                type: integer
                                description: ID của món ăn
                                example: 7
                              name:
                                type: string
                                description: Tên món ăn
                                example: "Cà phê sữa đá"
                              quantity:
                                type: integer
                                description: Số lượng
                                example: 2
                              unitPrice:
                                type: number
                                description: Đơn giá
                                example: 20000
              examples:
                successResponse:
                  summary: Danh sách đơn hàng hôm nay
                  value:
                    success: true
                    data:
                      - id: 123
                        orderNumber: "HBC001KSK0012510230001"
                        status: 2
                        paymentStatus: 0
                        totalPrice: 95000
                        note: "Không hành"
                        foods:
                          - id: 7
                            name: "Cà phê sữa đá"
                            quantity: 2
                            unitPrice: 20000
                          - id: 8
                            name: "Bánh mì"
                            quantity: 1
                            unitPrice: 15000
                      - id: 124
                        orderNumber: "HBC001KSK0012510230002"
                        status: 1
                        paymentStatus: 1
                        totalPrice: 40000
                        note: null
                        foods:
                          - id: 9
                            name: "Trà đá"
                            quantity: 2
                            unitPrice: 5000
        '401':
          description: Không có token hoặc token không hợp lệ
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
        '500':
          description: Lỗi server
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

  /api/orders:
    post:
      tags:
        - Orders
      summary: Tạo đơn hàng mới
      description: |
        Tạo đơn hàng mới từ thiết bị order (kiosk, tablet, web).
        
        **Quy trình:**
        1. Sinh orderNumber tự động: [shopCode][deviceCode][seq] (ví dụ: HBC001KSK0012510230001)
        2. Tính totalPrice từ danh sách items
        3. Tạo bản ghi Order
        4. Tạo các bản ghi OrderFood (junction table)
        5. Emit socket event để cập nhật realtime cho dashboard/caller
        
        **Lưu ý:**
        - Không cần authentication (public endpoint cho kiosk)
        - items phải có ít nhất 1 món
        - Mặc định: status=1 (Received), paymentStatus=0 (Unpaid), paymentMethod=0 (Cash)
      requestBody:
        required: true
        description: Thông tin đơn hàng
        content:
          application/json:
            schema:
              type: object
              required:
                - shopCode
                - deviceCode
                - items
              properties:
                shopCode:
                  type: string
                  description: Mã cửa hàng (3 ký tự chữ + 3 số, ví dụ HBC001)
                  pattern: '^[A-Z]{3}\d{3}$'
                  example: "HBC001"
                deviceCode:
                  type: string
                  description: Mã thiết bị (3 ký tự chữ + 3 số, ví dụ KSK001)
                  pattern: '^[A-Z]{3}\d{3}$'
                  example: "KSK001"
                paymentStatus:
                  type: integer
                  description: |
                    Trạng thái thanh toán (mặc định: 0)
                    - 0: Unpaid (Chưa thanh toán)
                    - 1: Paid (Đã thanh toán)
                  enum: [0, 1]
                  default: 0
                  example: 0
                paymentMethod:
                  type: integer
                  description: |
                    Phương thức thanh toán (mặc định: 0)
                    - 0: Cash (Tiền mặt)
                    - 1: Bank Transfer (Chuyển khoản)
                  enum: [0, 1]
                  default: 0
                  example: 0
                note:
                  type: string
                  description: Ghi chú của khách hàng
                  nullable: true
                  maxLength: 500
                  example: "Không hành, ít đá"
                items:
                  type: array
                  description: Danh sách món ăn (tối thiểu 1 món)
                  minItems: 1
                  items:
                    type: object
                    required:
                      - foodId
                    properties:
                      foodId:
                        type: integer
                        description: ID của món ăn
                        minimum: 1
                        example: 7
                      quantity:
                        type: integer
                        description: Số lượng (mặc định: 1)
                        minimum: 1
                        default: 1
                        example: 2
            examples:
              cashOrder:
                summary: Đơn hàng thanh toán tiền mặt
                value:
                  shopCode: "HBC001"
                  deviceCode: "KSK001"
                  paymentStatus: 0
                  paymentMethod: 0
                  note: "Không hành"
                  items:
                    - foodId: 7
                      quantity: 2
                    - foodId: 8
                      quantity: 1
              bankTransferOrder:
                summary: Đơn hàng chuyển khoản (đã thanh toán)
                value:
                  shopCode: "HBC001"
                  deviceCode: "KSK001"
                  paymentStatus: 1
                  paymentMethod: 1
                  note: "Đã chuyển khoản"
                  items:
                    - foodId: 9
                      quantity: 3
              minimalOrder:
                summary: Đơn hàng tối giản (chỉ truyền required fields)
                value:
                  shopCode: "HBC001"
                  deviceCode: "KSK001"
                  items:
                    - foodId: 7
                      quantity: 2
      responses:
        '200':
          description: Tạo đơn hàng thành công
          content:
            application/json:
              schema:
                type: object
                properties:
                  success:
                    type: boolean
                    example: true
                  data:
                    type: object
                    properties:
                      id:
                        type: integer
                        description: ID của đơn hàng
                        example: 123
                      orderNumber:
                        type: string
                        description: Số đơn hàng tự động sinh
                        example: "HBC001KSK0012510230001"
                      status:
                        type: integer
                        description: Trạng thái đơn (mặc định: 1=Received)
                        example: 1
                      paymentStatus:
                        type: integer
                        description: Trạng thái thanh toán
                        example: 0
                      paymentMethod:
                        type: integer
                        description: Phương thức thanh toán
                        example: 0
                      totalPrice:
                        type: number
                        description: Tổng tiền (tính từ items)
                        example: 55000
                      note:
                        type: string
                        nullable: true
                        example: "Không hành"
                      shopCode:
                        type: string
                        example: "HBC001"
                      deviceCode:
                        type: string
                        example: "KSK001"
                      createdAt:
                        type: string
                        format: date-time
                        example: "2025-10-23T07:30:25.123Z"
                      updatedAt:
                        type: string
                        format: date-time
                        example: "2025-10-23T07:30:25.123Z"
              examples:
                successResponse:
                  summary: Đơn hàng được tạo thành công
                  value:
                    success: true
                    data:
                      id: 123
                      orderNumber: "HBC001KSK0012510230001"
                      status: 1
                      paymentStatus: 0
                      paymentMethod: 0
                      totalPrice: 55000
                      note: "Không hành"
                      shopCode: "HBC001"
                      deviceCode: "KSK001"
                      createdAt: "2025-10-23T07:30:25.123Z"
                      updatedAt: "2025-10-23T07:30:25.123Z"
        '400':
          description: Dữ liệu không hợp lệ
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
              examples:
                invalidData:
                  summary: Dữ liệu không hợp lệ
                  value:
                    success: false
                    message: "Invalid order data"
                emptyItems:
                  summary: Danh sách món ăn rỗng
                  value:
                    success: false
                    message: "Items cannot be empty"
        '500':
          description: Lỗi server
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

/api/orders/{id}/status:
  patch:
    summary: Update order status
    tags:
      - Orders
    parameters:
      - in: path
        name: id
        required: true
        schema:
          type: integer
        description: Order ID
    requestBody:
      required: true
      content:
        application/json:
          schema:
            type: object
            required:
              - status
            properties:
              status:
                type: integer
                enum: [0, 1, 2, 3, 4]
                description: 0=Cancelled, 1=Received, 2=Processing, 3=Completed, 4=Delivered
              shopCode:
                type: string
                example: HBC001
    responses:
      200:
        description: Status updated successfully
      404:
        description: Order not found

/api/orders/{id}/details:
  patch:
    summary: Update order details (items, note)
    tags:
      - Orders
    parameters:
      - in: path
        name: id
        required: true
        schema:
          type: integer
        description: Order ID
    requestBody:
      required: true
      content:
        application/json:
          schema:
            type: object
            properties:
              note:
                type: string
              items:
                type: array
                items:
                  type: object
                  properties:
                    foodId:
                      type: integer
                    quantity:
                      type: integer
    responses:
      200:
        description: Details updated successfully
      404:
        description: Order not found

/api/orders/{id}/payment-status:
  get:
    summary: Check payment status of an order
    tags:
      - Orders
    parameters:
      - in: path
        name: id
        required: true
        schema:
          type: integer
        description: Order ID
    responses:
      200:
        description: Payment status retrieved
        content:
          application/json:
            schema:
              type: object
              properties:
                success:
                  type: boolean
                data:
                  type: object
                  properties:
                    paid:
                      type: boolean

/api/orders/search:
  get:
    summary: Search orders with filters (Manager only)
    tags:
      - Orders
      - Manager
    security:
      - bearerAuth: []
    parameters:
      - in: query
        name: fromDate
        schema:
          type: string
          pattern: ^\d{8}$
        description: Start date in yyyymmdd format (e.g., 20250801)
        example: "20250801"
      - in: query
        name: toDate
        schema:
          type: string
          pattern: ^\d{8}$
        description: End date in yyyymmdd format (e.g., 20250817)
        example: "20250817"
      - in: query
        name: minTotal
        schema:
          type: integer
        description: Minimum total price
        example: 0
      - in: query
        name: maxTotal
        schema:
          type: integer
        description: Maximum total price
        example: 100000
      - in: query
        name: status
        schema:
          type: string
        description: Order status (comma-separated integers 0-4)
        example: "2,3"
      - in: query
        name: paymentStatus
        schema:
          type: string
        description: Payment status (comma-separated 0=Unpaid,1=Paid)
        example: "1"
      - in: query
        name: page
        schema:
          type: integer
        description: Page number (default 1)
        example: 1
      - in: query
        name: pageSize
        schema:
          type: integer
        description: Items per page (default 50)
        example: 20
      - in: query
        name: sortBy
        schema:
          type: string
          enum: [updatedAt, totalPrice, orderNumber]
        description: Sort field
        example: updatedAt
      - in: query
        name: sortOrder
        schema:
          type: string
          enum: [ASC, DESC]
        description: Sort order
        example: DESC
    responses:
      200:
        description: Search results with pagination
        content:
          application/json:
            schema:
              type: object
              properties:
                success:
                  type: boolean
                data:
                  type: object
                  properties:
                    rows:
                      type: array
                      items:
                        $ref: '#/components/schemas/Order'
                    count:
                      type: integer
                    page:
                      type: integer
                    pageSize:
                      type: integer
      401:
        description: Unauthorized
      403:
        description: Forbidden - Manager role required
