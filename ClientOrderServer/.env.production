# ===========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ===========================================
# File này dành cho môi trường production
# Auto-loaded khi NODE_ENV=production
# ⚠️ QUAN TRỌNG: Cập nhật tất cả các giá trị placeholder trước khi deploy!

# Server Configuration
PORT=3000
NODE_ENV=production

# Database Configuration (Production)
# ⚠️ CẬP NHẬT: Thay bằng thông tin database production thực tế
DB_HOST=your-production-db-host.com
DB_PORT=5432
DB_NAME=order_db_prod
DB_USER=production_user
DB_PASSWORD=CHANGE_THIS_SECURE_PASSWORD

# Security and JWT
# ⚠️ CẬP NHẬT: Generate một secret key mạnh và bảo mật
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_STRONG_RANDOM_SECRET_KEY_IN_PRODUCTION
JWT_EXPIRES=2h

# CORS Configuration (Production - chỉ cho phép domain cụ thể)
# ⚠️ CẬP NHẬT: Thay bằng domain frontend production thực tế
CORS_ORIGIN=https://your-production-frontend.com,https://www.your-production-frontend.com

# Logging (Production - less verbose)
LOG_LEVEL=info
# End of .env.production