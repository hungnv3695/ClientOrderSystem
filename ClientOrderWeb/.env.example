# Sample environment variables for ClientOrderWeb (copy to .env or .env.local)
# API base (include /api suffix if backend exposes it that way)
VITE_API_URL=http://127.0.0.1:3000/api

# Socket.io base URL
VITE_SOCKET_URL=http://127.0.0.1:3000

# Shop / device identification
VITE_SHOP_CODE=SH123
VITE_DEVICE_CODE=DV001

# QR payment account info
VITE_QR_BANK=VCB
VITE_QR_ACC=0011004365510
VITE_QR_ACC_NAME=Nguyen Viet Hung

# Optional: override payment content pattern in code if needed
# (Currently buildPaymentContent composes from SHOP + DEVICE + amount)
# VITE_PAYMENT_CONTENT_TEMPLATE="${SHOP_CODE} ${DEVICE_CODE} ${AMOUNT}"
