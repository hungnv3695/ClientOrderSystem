# Environment Configuration for Development
# File này được sử dụng khi chạy: npm run dev

# Backend API URL - Địa chỉ server backend
# Giá trị này sẽ được inject vào import.meta.env.VITE_API_URL
VITE_API_URL=http://localhost:3000/api

# Socket.IO URL - Địa chỉ WebSocket server (realtime communication)
# Dùng cho OrderDashboard, OrderCaller để nhận cập nhật realtime
VITE_SOCKET_URL=http://localhost:3000

# Print Service URL - Địa chỉ service in hóa đơn
# Dùng để gửi lệnh in đến máy in Epson thông qua local service
VITE_PRINT_SERVICE_URL=http://localhost:3003/api/print
