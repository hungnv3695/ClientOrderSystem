# Environment Configuration for Production
# File này được sử dụng khi build production: npm run build

# Backend API URL - Địa chỉ server backend production
# Thay đổi domain này thành domain thực tế của bạn
VITE_API_URL=https://api.yourdomain.com/api

# Socket.IO URL - Địa chỉ WebSocket server production
# Phải giống với domain backend (hỗ trợ WebSocket)
VITE_SOCKET_URL=https://api.yourdomain.com

# Print Service URL - Địa chỉ service in hóa đơn production
# LƯU Ý: Service in thường chạy local, cần cấu hình đặc biệt cho production
# Option 1: Deploy print service lên cloud (không khuyến khích - cần access máy in local)
# Option 2: Giữ localhost và chỉ in từ máy có cài print service
VITE_PRINT_SERVICE_URL=http://localhost:3003/api/print
